{
  "name": "join",
  "title": "Join",
  "inputs": ["x", "y"],
  "state": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["left_join", "inner_join", "right_join", "full_join", "semi_join", "anti_join"],
        "default": "left_join"
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "xCol": { "type": "string" },
            "op": { "type": "string", "enum": ["==", ">", ">=", "<", "<="] },
            "yCol": { "type": "string" }
          }
        },
        "default": []
      },
      "exprs": { "type": "array", "items": { "type": "string" }, "default": [] },
      "suffix_x": { "type": "string", "default": ".x" },
      "suffix_y": { "type": "string", "default": ".y" }
    }
  },
  "requests": [],
  "js": ["join.js"],
  "css": ["join.css"]
}
